# API
APOLO_ENV=development
APOLO_API_HOST=0.0.0.0
APOLO_API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Provider keys (optional; configure only keys you own)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# MCP server connection security. Use exact HTTPS hostnames, comma-separated.
MCP_ALLOWED_HOSTS=
# Admin-owned stdio process aliases. Never accept commands from workspace users.
MCP_STDIO_SERVERS_JSON={}
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
APOLO_MCP_ENCRYPTION_KEY=
